{
  "name": "homemate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HomeMate - AI Household Operating System for Elders, Hostel Students, and Families",
  "scripts": {
    "start": "node server/dist/index.js",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build --prefix server && npm run build --prefix client"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/node": "^26.6.6",
    "@vercel/node": "^32.0.0",
    "concurrently": "^9.1.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "cookie": "^2.0.2",
    "zod": "^4.6.7"
  }
}
